WHILE [#101 LT 3] DO1
#101=#101+1
END1
N15G65P9001A1.5B#100
N20 M98 P1234 L2
#3006=1 (CHECK TOOL)
/1 G0 X1.
$1 G0 Z[#100*2]
!2 M3 S1000
DPRNT[X#100[53]]
G10L2P1X0.
